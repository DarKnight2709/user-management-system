// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum InvitationDeliveryStatus {
  NOT_QUEUED
  QUEUED
  SENT
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS
}

enum AuditTargetType {
  USER
  ORGANIZATION
  ORGANIZATION_MEMBER
  ROLE
  ORGANIZATION_INVITATION
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  username            String                   @unique
  firstName           String                   @map("first_name")
  lastName            String                   @map("last_name")
  birthDate           DateTime                 @map("birth_date")
  hashedPassword      String                   @map("hashed_password")
  avatarKey           String?                  @map("avatar_key")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  deletedAt           DateTime?                @map("deleted_at")
  refreshTokens       RefreshToken[]
  organizationMembers OrganizationMember[]
  ownedOrganizations  Organization[]           @relation("OrganizationOwner")
  platformRoles       UserPlatformRole[]
  invitationsSent     OrganizationInvitation[] @relation("InvitationSender")

  @@map("users")
}

model AvatarCleanupTask {
  id            String    @id @default(uuid())
  objectKey     String    @unique @map("object_key")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  leaseToken    String?   @map("lease_token")
  leaseUntil    DateTime? @map("lease_until")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([nextAttemptAt])
  @@map("avatar_cleanup_tasks")
}

model RefreshToken {
  id               String    @id @default(uuid())
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userId           String    @map("user_id")
  familyId         String    @map("family_id")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OrganizationInvitation {
  id              String                   @id @default(uuid())
  organizationId  String                   @map("organization_id")
  email           String
  tokenHash       String                   @unique @map("token_hash")
  status          InvitationStatus         @default(PENDING)
  expiresAt       DateTime                 @map("expires_at")
  invitedById     String                   @map("invited_by_id")
  acceptedById    String?                  @map("accepted_by_id")
  acceptedAt      DateTime?                @map("accepted_at")
  revokedAt       DateTime?                @map("revoked_at")
  lastRequestedAt DateTime                 @default(now()) @map("last_requested_at")
  resendCount     Int                      @default(0) @map("resend_count")
  deliveryVersion Int                      @default(1) @map("delivery_version")
  deliveryStatus  InvitationDeliveryStatus @default(NOT_QUEUED) @map("delivery_status")
  sentAt          DateTime?                @map("sent_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, email], where: { status: "PENDING" }, map: "organization_invitations_pending_email_key")
  @@index([organizationId, createdAt])
  @@map("organization_invitations")
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  ownerId   String    @map("owner_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members     OrganizationMember[]
  roles       Role[]
  owner       User                     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  invitations OrganizationInvitation[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberRoles  MemberRole[]
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Role {
  id             String    @id @default(uuid())
  name           String    @map("name")
  organizationId String?   @map("organization_id")
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  memberRoles     MemberRole[]
  rolePermissions RolePermission[]
  platformUsers   UserPlatformRole[]

  @@unique([name, organizationId])
  @@unique([name], where: { organizationId: null }, map: "roles_global_name_key")
  @@index([organizationId])
  @@map("roles")
}

model UserPlatformRole {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_platform_roles")
}

model MemberRole {
  id                   String    @id @default(uuid())
  organizationMemberId String    @map("organization_member_id")
  roleId               String    @map("role_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Restrict)
  role               Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationMemberId, roleId])
  @@map("member_roles")
}

model RolePermission {
  id           String    @id @default(uuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Permission {
  id          String    @id @default(uuid())
  action      String
  resource    String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model AuditEvent {
  eventId        String          @id @map("event_id") @db.Uuid
  schemaVersion  Int             @map("schema_version")
  action         String
  actorId        String?         @map("actor_id")
  actorType      AuditActorType  @map("actor_type")
  targetId       String          @map("target_id")
  targetType     AuditTargetType @map("target_type")
  organizationId String?         @map("organization_id")
  requestId      String          @map("request_id")
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(3)
  recordedAt     DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  payload        Json

  @@index([actorId, occurredAt, eventId])
  @@index([targetType, targetId, occurredAt, eventId])
  @@index([action, occurredAt, eventId])
  @@index([organizationId, occurredAt, eventId])
  @@map("audit_events")
}
