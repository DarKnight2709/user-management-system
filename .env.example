S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=
S3_PUBLIC_URL=
# Optional: error, warn, info, http, verbose, debug, silly. Defaults to info.
LOG_LEVEL=
LOG_DATABASE_QUERIES=

SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
