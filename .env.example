# App Port
PORT=

# Database Credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection String for Prisma
DATABASE_URL=

# JWT
# Generate two independent random secrets of at least 64 characters, without whitespace.
# Never commit or share real secrets.
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=
JWT_REFRESH_TOKEN_EXPIRES_IN=

# Minio
# In production S3_ACCESS_KEY/S3_SECRET_KEY are the application's own account
# (created by minio-init, limited to the avatars bucket) and must differ from the
# MinIO root account below. The root variables are used only by
# docker-compose.prod.yml; local Compose still uses S3_ACCESS_KEY as the root.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=
S3_PUBLIC_URL=
# Optional: error, warn, info, http, verbose, debug, silly. Defaults to info.
LOG_LEVEL=
LOG_DATABASE_QUERIES=

SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
# ISO date, e.g. YYYY-MM-DD
SEED_ADMIN_BIRTH_DATE=

FRONTEND_URL=
REDIS_HOST=
REDIS_PORT=
# Required by docker-compose.prod.yml (Redis refuses unauthenticated clients).
REDIS_PASSWORD=
# Grafana admin password in production; the admin username stays "admin".
GRAFANA_ADMIN_PASSWORD=
REDIS_QUEUE_PREFIX=
INVITATION_TOKEN_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
